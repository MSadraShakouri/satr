<?xml version="1.0" encoding="utf-8"?>
<!-- Capacitor's bridge layout, with Satr's WebView instead of the stock one
     (res/layout shadows the library's layout of the same name). The one
     difference: SatrWebView adds a "Line" item to Android's own selection bar
     — Markor's whole-line selection — next to the Copy, Cut, Paste and Select
     all that Android already puts there. Everything else about the layout is
     Capacitor's, id and all: the bridge looks its WebView up by @id/webview. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <com.msadrashakouri.satr.SatrWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
